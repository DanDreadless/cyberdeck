# Copy to .env (dev, repo root) or ~/.config/cyberdeck/.env (installed) and fill in.
# .env is gitignored. Never put real values in this example file.
# Precedence: real environment variables > ~/.config/cyberdeck/.env > ./.env

# Bearer token for `cyberdeck mcp --http`. Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
# If empty, `cyberdeck mcp --http` generates one and writes it to ~/.config/cyberdeck/.env (mode 600).
CYBERDECK_MCP_TOKEN=

# Optional API keys used by tool plugins (only passed to the tool that needs them)
WPSCAN_API_TOKEN=
# HTB_API_TOKEN=          # future: Hack The Box API integration

# Optional overrides
# CYBERDECK_WORKSPACE_ROOT=~/Documents/htb      # the default; `cyberdeck new` can remember another
# CYBERDECK_VPN_DIR=~/Documents/htb   # folder holding your .ovpn files; default: the workspace folder
# CYBERDECK_VPN_CONFIG=~/Documents/htb/machines_us-1.ovpn   # default: machines_*.ovpn in the VPN folder
# CYBERDECK_HOSTS_FILE=/etc/hosts   # tests point this at a temp file

# Scope: Cyberdeck refuses targets outside these CIDRs (comma-separated or a JSON list).
# CYBERDECK_SCOPE_CIDRS=10.10.0.0/16,10.129.0.0/16   # the default (HTB lab ranges); replaces it if set
# CYBERDECK_SCOPE_EXTRA=                             # added to the defaults, e.g. 127.0.0.1/32 for local testing
